  "components": [
    {
      "name": "Signage Band",
      "kind": "nav",
      "refersTo": "signage-band",
      "description": "Sticky navy band carrying the mark, tabs, version and Logout; navy in both themes.",
      "html": "<nav class=\"ds-band\"><a class=\"ds-band-mark\"><span class=\"ds-band-disc\">G</span>GateCHA</a><div class=\"ds-band-tabs\"><a class=\"ds-band-tab ds-active\">Dashboard</a><a class=\"ds-band-tab\">API Keys</a><a class=\"ds-band-tab\">Settings</a></div><span class=\"ds-band-ver\">v0.9.5</span><button class=\"ds-band-logout\">Logout</button></nav>",
      "css": ".ds-band{display:flex;align-items:stretch;gap:40px;height:56px;padding:0 32px;background:var(--color-band,#10285A);color:var(--color-band-ink,#fff);border-bottom:1px solid var(--color-band-rule,#2A4479);font-family:Overpass,system-ui,sans-serif}.ds-band-mark{display:flex;align-items:center;gap:10px;font-weight:800;font-size:18px;letter-spacing:-0.025em}.ds-band-disc{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:9999px;background:var(--color-band-ink,#fff);color:var(--color-band,#10285A);font-weight:800;font-size:16px;line-height:1}.ds-band-tabs{display:flex;gap:4px}.ds-band-tab{display:flex;align-items:center;padding:3px 16px 0;border-bottom:3px solid transparent;font-size:14px;font-weight:600;color:var(--color-band-muted,#C6D0E4);transition:color .15s;cursor:pointer}.ds-band-tab:hover{color:var(--color-band-ink,#fff)}.ds-band-tab.ds-active{border-bottom-color:var(--color-band-ink,#fff);color:var(--color-band-ink,#fff)}.ds-band-ver{margin-left:auto;align-self:center;font-family:'Overpass Mono',ui-monospace,monospace;font-size:12px;color:var(--color-band-muted,#C6D0E4)}.ds-band-logout{align-self:center;min-height:32px;padding:0 12px;border-radius:4px;border:1px solid var(--color-band-rule,#2A4479);background:transparent;color:var(--color-band-ink,#fff);font:600 14px Overpass,system-ui,sans-serif;transition:background .15s}.ds-band-logout:hover{background:rgb(255 255 255/.1)}.ds-band-logout:focus-visible{outline:none;box-shadow:0 0 0 2px var(--color-band-ink,#fff)}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Navy action for form submits and dialog confirms.",
      "html": "<button class=\"ds-btn-primary\">Create key</button>",
      "css": ".ds-btn-primary{padding:8px 16px;border:none;border-radius:6px;background:var(--color-action,#10285A);color:var(--color-action-ink,#fff);font:600 14px/20px Overpass,system-ui,sans-serif;transition:background .15s;cursor:pointer}.ds-btn-primary:hover{background:var(--color-action-hover,#0B1E45)}.ds-btn-primary:focus-visible{outline:none;box-shadow:0 0 0 2px var(--color-focus,#1F4FC1)}.ds-btn-primary:disabled{opacity:.5}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outlined panel button for Edit and Enable/Disable on the key detail page.",
      "html": "<button class=\"ds-btn-secondary\">Edit</button>",
      "css": ".ds-btn-secondary{padding:8px 16px;border:1px solid var(--color-rule-strong,#B9C1CD);border-radius:6px;background:var(--color-panel,#fff);color:var(--color-ink,#14213D);font:600 14px/20px Overpass,system-ui,sans-serif;transition:background .15s;cursor:pointer}.ds-btn-secondary:hover{background:var(--color-sunken,#F7F8FA)}.ds-btn-secondary:focus-visible{outline:none;box-shadow:0 0 0 2px var(--color-focus,#1F4FC1)}"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Destructive action; always confirmed through the dialog.",
      "html": "<button class=\"ds-btn-danger\">Delete</button>",
      "css": ".ds-btn-danger{padding:8px 16px;border:none;border-radius:6px;background:var(--color-danger,#C8001A);color:var(--color-action-ink,#fff);font:600 14px/20px Overpass,system-ui,sans-serif;transition:background .15s;cursor:pointer}.ds-btn-danger:hover{background:var(--color-danger-hover,#A30015)}.ds-btn-danger:focus-visible{outline:none;box-shadow:0 0 0 2px var(--color-fail,#C8001A)}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input-text",
      "description": "Form field on the panel surface with a strong hairline border.",
      "html": "<label class=\"ds-field\"><span class=\"ds-field-label\">Name</span><input class=\"ds-input\" placeholder=\"My website\"></label>",
      "css": ".ds-field{display:block;font-family:Overpass,system-ui,sans-serif}.ds-field-label{display:block;margin-bottom:4px;font-size:14px;font-weight:500;color:var(--color-ink-2,#3A4560)}.ds-input{width:100%;padding:8px 12px;border:1px solid var(--color-rule-strong,#B9C1CD);border-radius:6px;background:var(--color-panel,#fff);color:var(--color-ink,#14213D);font:400 14px/20px Overpass,system-ui,sans-serif;caret-color:var(--color-action,#10285A)}.ds-input::placeholder{color:var(--color-muted,#5B6478)}.ds-input:focus{outline:none;border-color:var(--color-focus,#1F4FC1);box-shadow:0 0 0 2px var(--color-focus,#1F4FC1)}"
    },
    {
      "name": "Status Chips",
      "kind": "chip",
      "refersTo": "status-chip-disturbed",
      "description": "Transit status vocabulary; colour always backs the words.",
      "html": "<div class=\"ds-chips\"><span class=\"ds-chip ds-normal\"><i></i>Normal service</span><span class=\"ds-chip ds-disturbed\"><i></i>Disturbed — <b>31</b> failed today</span><span class=\"ds-chip ds-quiet\">No traffic today</span><span class=\"ds-chip ds-closed\">Closed</span></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:8px}.ds-chip{display:inline-flex;align-items:center;gap:6px;white-space:nowrap;padding:2px 8px;border-radius:3px;font:700 12px/16px Overpass,system-ui,sans-serif}.ds-chip i{width:7px;height:7px;border-radius:9999px;background:currentColor}.ds-chip b{padding:0 4px;border-radius:2px;background:var(--color-panel,#fff);color:var(--color-fail,#C8001A);font-family:'Overpass Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}.ds-normal{color:var(--color-ok,#00754E)}.ds-disturbed{background:var(--color-warn,#E8A400);color:var(--color-warn-ink,#2A1E00)}.ds-quiet{color:var(--color-muted,#5B6478)}.ds-closed{background:var(--color-closed,#ECEDEF);color:var(--color-closed-ink,#5E6166)}"
    },
    {
      "name": "Line Bullets",
      "kind": "custom",
      "refersTo": "line-bullet-md",
      "description": "Round metro bullet carrying the key's id; colours cycle over eight, the number is the identity.",
      "html": "<div class=\"ds-bullets\"><span class=\"ds-bullet\" style=\"background:var(--color-line-1);color:var(--color-line-1-ink)\">1</span><span class=\"ds-bullet\" style=\"background:var(--color-line-2);color:var(--color-line-2-ink)\">2</span><span class=\"ds-bullet\" style=\"background:var(--color-line-3);color:var(--color-line-3-ink)\">3</span><span class=\"ds-bullet\" style=\"background:var(--color-line-4);color:var(--color-line-4-ink)\">4</span><span class=\"ds-bullet\" style=\"background:var(--color-line-5);color:var(--color-line-5-ink)\">5</span><span class=\"ds-bullet\" style=\"background:var(--color-line-6);color:var(--color-line-6-ink)\">6</span><span class=\"ds-bullet\" style=\"background:var(--color-line-7);color:var(--color-line-7-ink)\">7</span><span class=\"ds-bullet\" style=\"background:var(--color-line-8);color:var(--color-line-8-ink)\">8</span><span class=\"ds-bullet ds-small\" style=\"background:var(--color-line-5);color:var(--color-line-5-ink)\">13</span><span class=\"ds-bullet ds-lg\" style=\"background:var(--color-line-3);color:var(--color-line-3-ink)\">3</span></div>",
      "css": ".ds-bullets{display:flex;align-items:center;gap:8px}.ds-bullet{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:9999px;box-shadow:inset 0 0 0 1px var(--color-line-ring,rgb(20 33 61/.18));font:800 14px/1 Overpass,system-ui,sans-serif;font-variant-numeric:tabular-nums;user-select:none}.ds-bullet.ds-small{width:18px;height:18px;font-size:10px}.ds-bullet.ds-lg{width:36px;height:36px;font-size:18px}"
    },
    {
      "name": "Network Status Board",
      "kind": "card",
      "refersTo": "board-row-disturbed",
      "description": "The dashboard's signature table: one row per line, disturbed first on amber-soft, counts in tabular mono.",
      "html": "<section class=\"ds-board\"><header class=\"ds-board-head\"><h2>Network status <small>Today (UTC)</small></h2><a>All keys →</a></header><table><thead><tr><th>Line</th><th>Key</th><th class=\"ds-r\">Challenges</th><th class=\"ds-r\">Failed</th><th>Status</th></tr></thead><tbody><tr class=\"ds-dist\"><td><span class=\"ds-b\" style=\"background:var(--color-line-5);color:var(--color-line-5-ink)\">5</span></td><td><b>Carrousel</b><div>muhctv.example.ca</div></td><td class=\"ds-r ds-m\">74</td><td class=\"ds-r ds-m ds-f\">31</td><td><span class=\"ds-st ds-st-d\">Disturbed</span></td></tr><tr><td><span class=\"ds-b\" style=\"background:var(--color-line-1);color:var(--color-line-1-ink)\">1</span></td><td><b>Appel Caisse</b><div>www.example.fr</div></td><td class=\"ds-r ds-m\">75</td><td class=\"ds-r ds-m ds-z\">0</td><td><span class=\"ds-st ds-st-n\">Normal service</span></td></tr></tbody></table></section>",
      "css": ".ds-board{border:1px solid var(--color-rule,#DDE2E8);border-radius:6px;background:var(--color-panel,#fff);font-family:Overpass,system-ui,sans-serif;color:var(--color-ink,#14213D)}.ds-board-head{display:flex;justify-content:space-between;align-items:baseline;padding:12px 20px;border-bottom:1px solid var(--color-rule,#DDE2E8)}.ds-board-head h2{margin:0;font-size:17px;font-weight:800}.ds-board-head small{margin-left:8px;font-size:13px;font-weight:500;color:var(--color-muted,#5B6478)}.ds-board-head a{font-size:14px;font-weight:600;color:var(--color-link,#1F4FC1)}.ds-board table{width:100%;border-collapse:collapse}.ds-board th{padding:8px 12px;text-align:left;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:var(--color-muted,#5B6478)}.ds-board td{padding:8px 12px;border-top:1px solid var(--color-rule-soft,#EBEEF2);font-size:14px;transition:opacity .15s}.ds-board td div{font-size:12px;color:var(--color-muted,#5B6478)}.ds-board tr.ds-dist td{background:var(--color-warn-soft,#FFF7E0);border-color:var(--color-warn-edge,#F1D88E)}.ds-board tr.ds-dist+tr td{border-top-color:var(--color-warn-edge,#F1D88E)}.ds-board tbody:hover tr:not(:hover){opacity:.45}.ds-r{text-align:right!important}.ds-m{font-family:'Overpass Mono',ui-monospace,monospace;font-variant-numeric:tabular-nums}.ds-f{font-weight:700;color:var(--color-fail,#C8001A)}.ds-z{color:var(--color-muted,#5B6478)}.ds-b{display:inline-flex;align-items:center;justify-content:center;width:26px;height:26px;border-radius:9999px;box-shadow:inset 0 0 0 1px var(--color-line-ring,rgb(20 33 61/.18));font-weight:800;font-size:14px}.ds-st{display:inline-flex;padding:2px 8px;border-radius:3px;font-size:12px;font-weight:700}.ds-st-d{background:var(--color-warn,#E8A400);color:var(--color-warn-ink,#2A1E00)}.ds-st-n{color:var(--color-ok,#00754E)}"
    },
    {
      "name": "KPI Strip",
      "kind": "card",
      "refersTo": "panel",
      "description": "Four figures divided by 1px hairlines; label, tabular mono number, a line of context.",
      "html": "<section class=\"ds-kpis\"><div><p class=\"ds-l\">Challenges · all time</p><p class=\"ds-v\">5,231</p><p class=\"ds-h\">264 today</p></div><div><p class=\"ds-l\">Failed · all time</p><p class=\"ds-v ds-fail\">120</p><p class=\"ds-h ds-fail\"><b>36 today</b></p></div></section>",
      "css": ".ds-kpis{display:grid;grid-template-columns:repeat(2,1fr);gap:1px;overflow:hidden;border:1px solid var(--color-rule,#DDE2E8);border-radius:6px;background:var(--color-rule,#DDE2E8);font-family:Overpass,system-ui,sans-serif}.ds-kpis>div{padding:16px 20px;background:var(--color-panel,#fff)}.ds-kpis p{margin:0}.ds-l{font-size:11px;line-height:16px;font-weight:700;text-transform:uppercase;letter-spacing:.09em;color:var(--color-muted,#5B6478)}.ds-v{margin-top:6px!important;font:600 32px/40px 'Overpass Mono',ui-monospace,monospace;letter-spacing:-0.025em;font-variant-numeric:tabular-nums;color:var(--color-ink,#14213D)}.ds-h{margin-top:4px!important;font-size:12px;color:var(--color-muted,#5B6478)}.ds-fail{color:var(--color-fail,#C8001A)}"
    }
  ],
  "narrative": {
    "northStar": "Info trafic",
    "overview": "The admin is a transit network's status board. Every API key is a numbered line of the network, drawn as a round metro bullet in one of eight line colours, and the dashboard opens on the board that says, per line, Normal service, No traffic today, Disturbed or Closed. A navy signage band carries the navigation in both themes; below it the ground is porcelain by day and night-navy by night, following the system theme. Light and dark are both designed: the dark theme redefines the same semantic tokens, so no component branches on the theme.\n\nDensity is Operate density: tables on strict columns, every count in Overpass Mono tabular figures, structure drawn by 1px hairlines rather than drop-shadowed cards. Colour is spent on two things only: the identity of a line, and state. Amber means disturbed, red means failures, green means normal service, grey means closed, and every one of those colours is backed by words. The type is Overpass, a face derived from highway signage, self-hosted with its mono sibling; nothing loads from a font CDN.\n\nThe previous system (slate and brand blue, Inter, large rounded cards) is retired and is not a reference.",
    "keyCharacteristics": [
      "One number per key everywhere: the line number is the key's database id, shown in the bullet on the board, the list, the detail page and the chart legend.",
      "Eight line colours cycle; the number, never the colour, is the identity.",
      "Navy signage band on every screen, including the signed-out login (mark only).",
      "Hairline grid: panels are bordered, KPI strips are divided by 1px gaps over the rule colour.",
      "Tabular mono figures for every count, formatted en-US; every date is UTC.",
      "Focus dims the rest: hovering a board row or pinning a legend entry steps every other line back."
    ],
    "rules": [
      {
        "name": "The State-Only Rule",
        "body": "Green, amber, red and grey mean normal, disturbed, failed and closed, and nothing else. They never decorate.",
        "section": "colors"
      },
      {
        "name": "The Number Is the Line Rule",
        "body": "Colours cycle every eight lines (`((id - 1) % 8) + 1`). Never let a colour alone identify a key; the bullet always carries its number.",
        "section": "colors"
      },
      {
        "name": "The Same Names Rule",
        "body": "Dark mode redefines the same custom properties under `prefers-color-scheme: dark`. Components use semantic tokens only and never write a theme branch.",
        "section": "colors"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Every count is set in Overpass Mono with tabular figures and formatted with `toLocaleString('en-US')`. No bare `toLocaleString()`, no proportional digits in a column.",
        "section": "typography"
      },
      {
        "name": "The UTC Rule",
        "body": "\"Today\" is the current UTC day and every chart date is formatted in UTC (`en-US`, short month and day). Say so in the UI where it matters (\"Today (UTC)\").",
        "section": "typography"
      },
      {
        "name": "The Hairline Rule",
        "body": "Structure is drawn with 1px rules: panel borders in `hairline`, row separators in `hairline-soft`, KPI strips as a grid with a 1px gap over the `hairline` fill. No shadow cards.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do set every count in Overpass Mono tabular figures and format it with `toLocaleString('en-US')`.",
      "Do compute \"today\" and format chart dates in UTC, and label it (\"Today (UTC)\").",
      "Do show a key as its line bullet with its number wherever the key appears.",
      "Do back every status colour with its words: Normal service, No traffic today, Disturbed, Closed.",
      "Do put disturbed board rows on `disturbed-amber-soft` with `disturbed-amber-edge` borders and sort them first.",
      "Do dim non-selected lines only while a line is selected (hover or pin); at rest every row is full strength.",
      "Do pin the first disturbed line on the dashboard chart by default.",
      "Do read Chart.js colours from the CSS tokens at runtime and redraw on a theme change.",
      "Do keep the signage band navy in both themes and redefine only semantic tokens for dark."
    ],
    "donts": [
      "Don't use green, amber, red or grey for decoration; they mean state.",
      "Don't let a line colour stand alone as an identifier; colours repeat every eight lines.",
      "Don't add drop shadows to panels or cards; draw structure with 1px hairlines.",
      "Don't load fonts or assets from a CDN; Overpass and Overpass Mono ship with the app.",
      "Don't use flag emoji for countries; use the ISO code tag.",
      "Don't bring back the retired slate/brand-blue, Inter, large-rounded-card look."
    ]
  }
}